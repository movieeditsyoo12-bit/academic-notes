<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebGL Engine Test</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #030305; font-family: monospace; user-select: none; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; background: rgba(255, 255, 255, 0.4); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; border: 1px solid rgba(0, 0, 0, 0.5); display: none; }
        #instructions { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; text-align: center; background: rgba(0,0,0,0.8); padding: 20px; border-radius: 5px; cursor: pointer; }
    </style>
</head>
<body>

    <div id="crosshair"></div>
    <div id="instructions">CLICK TO ENGAGE 3D CANVAS MESH</div>

    <script src="https://cloudflare.com"></script>

    <script>
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x020204);
        scene.fog = new THREE.FogExp2(0x020204, 0.09);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        document.body.appendChild(renderer.domElement);

        const floorGeo = new THREE.PlaneGeometry(400, 400);
        const floorMat = new THREE.MeshStandardMaterial({ color: 0x0f0f13, roughness: 0.9 });
        const floor = new THREE.Mesh(floorGeo, floorMat);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        scene.add(floor);

        const pillarGeo = new THREE.BoxGeometry(1.5, 6, 1.5);
        const pillarMat = new THREE.MeshStandardMaterial({ color: 0x1c1c22, roughness: 1.0 });
        for (let i = 0; i < 35; i++) {
            const pillar = new THREE.Mesh(pillarGeo, pillarMat);
            pillar.position.set((Math.random() - 0.5) * 80, 3, (Math.random() - 0.5) * 80);
            pillar.castShadow = true;
            pillar.receiveShadow = true;
            scene.add(pillar);
        }

        const playerPivot = new THREE.Group();
        const playerMesh = new THREE.Group();
        playerPivot.add(playerMesh);
        scene.add(playerPivot);
        
        const bodyGeo = new THREE.CylinderGeometry(0.35, 0.35, 1.8, 16);
        const bodyMat = new THREE.MeshStandardMaterial({ color: 0x242b35, roughness: 0.7 });
        const body = new THREE.Mesh(bodyGeo, bodyMat);
        body.position.y = 0.9;
        body.castShadow = true;
        playerMesh.add(body);

        const visorGeo = new THREE.BoxGeometry(0.2, 0.15, 0.3);
        const visorMat = new THREE.MeshBasicMaterial({ color: 0x050505 });
        const visor = new THREE.Mesh(visorGeo, visorMat);
        visor.position.set(0, 1.4, -0.25);
        playerMesh.add(visor);

        const ambientLight = new THREE.AmbientLight(0x040408, 0.8);
        scene.add(ambientLight);

        const flashlight = new THREE.SpotLight(0xfff5e6, 15, 40, Math.PI / 7, 0.5, 1);
        flashlight.position.set(0.2, 1.2, -0.2);
        flashlight.castShadow = true;
        
        const lightTarget = new THREE.Object3D();
        scene.add(lightTarget);
        flashlight.target = lightTarget;
        playerMesh.add(flashlight);

        const instructions = document.getElementById('instructions');
        const crosshair = document.getElementById('crosshair');
        let isLocked = false;

        instructions.addEventListener('click', () => { document.body.requestPointerLock(); });

        document.addEventListener('pointerlockchange', () => {
            if (document.pointerLockElement === document.body) {
                instructions.style.display = 'none';
                crosshair.style.display = 'block';
                isLocked = true;
            } else {
                instructions.style.display = 'block';
                crosshair.style.display = 'none';
                isLocked = false;
            }
        });

        let yaw = 0, pitch = 0;
        document.addEventListener('mousemove', (e) => {
            if (!isLocked) return;
            yaw -= e.movementX * 0.0025;
            pitch -= e.movementY * 0.0025;
            pitch = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, pitch));
            playerPivot.rotation.y = yaw;
        });

        const input = { w: false, a: false, s: false, d: false };
        window.addEventListener('keydown', (e) => { if (e.key.toLowerCase() in input) input[e.key.toLowerCase()] = true; });
        window.addEventListener('keyup', (e) => { if (e.key.toLowerCase() in input) input[e.key.toLowerCase()] = false; });

        const speed = 0.09;
        function renderFrame() {
            requestAnimationFrame(renderFrame);
            let moveX = 0, moveZ = 0;
            if (input.w) moveZ -= 1;
            if (input.s) moveZ += 1;
            if (input.a) moveX -= 1;
            if (input.d) moveX += 1;

            if (moveX !== 0 || moveZ !== 0) {
                const length = Math.sqrt(moveX * moveX + moveZ * moveZ);
                const directionVector = new THREE.Vector3(moveX / length, 0, moveZ / length);
                directionVector.applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
                playerPivot.position.addScaledVector(directionVector, speed);
            }

            lightTarget.position.set(
                playerPivot.position.x - Math.sin(yaw) * 15,
                playerPivot.position.y + 1.2 + Math.sin(pitch) * 10,
                playerPivot.position.z - Math.cos(yaw) * 15
            );

            const cameraOffset = new THREE.Vector3(0.7, 3.2, 5.0); 
            cameraOffset.applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
            const targetCamPos = playerPivot.position.clone().add(cameraOffset);
            camera.position.lerp(targetCamPos, 0.1);
            
            const lookTarget = playerPivot.position.clone().add(new THREE.Vector3(-Math.sin(yaw) * 4, 1.2, -Math.cos(yaw) * 4));
            camera.lookAt(lookTarget);
            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        renderFrame();
    </script>
</body>
</html>
